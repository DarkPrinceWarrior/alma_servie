APP_NAME=alma_servie back
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=alma_servie
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://app:app@127.0.0.1:5432/alma_servie

# Data / research integration
# DATA_ROOT: где лежат db/*.parquet, artifacts/*, models/*
# RESEARCH_ROOT: где лежит код alma_service/, paano/, scripts/ для subprocess-запусков (worker)
DATA_ROOT=../..
RESEARCH_ROOT=../..

# Detection runs: при mock=true subprocess не стартует, только симулируется
# (используется в dev + в api-контейнере, у которого нет research-стэка).
# В prod worker-контейнере ставим DETECTION_MOCK=false.
DETECTION_MOCK=true
DETECTION_MOCK_DURATION_SECONDS=2.0

# JWT / auth
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_SECURE=false

# Seed admin: создать / обновить админ-пользователя при старте
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=false
