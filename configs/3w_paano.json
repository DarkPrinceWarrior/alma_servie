{
  "dataset": {
    "name": "3W",
    "version": "2.0.0",
    "upstream_commit": "227fce3",
    "raw_dir": "data/raw/3w/3W/dataset",
    "processed_dir": "data/processed/3w",
    "manifest_path": "data/processed/3w/manifest.parquet",
    "intervals_path": "data/processed/3w/intervals.parquet",
    "splits_path": "data/processed/3w/splits.parquet",
    "features_path": "data/processed/3w/features_1min.parquet",
    "label_col": "class",
    "state_col": "state",
    "transient_offset": 100,
    "event_labels": {
      "0": "NORMAL",
      "1": "ABRUPT_INCREASE_OF_BSW",
      "2": "SPURIOUS_CLOSURE_OF_DHSV",
      "3": "SEVERE_SLUGGING",
      "4": "FLOW_INSTABILITY",
      "5": "RAPID_PRODUCTIVITY_LOSS",
      "6": "QUICK_RESTRICTION_IN_PCK",
      "7": "SCALING_IN_PCK",
      "8": "HYDRATE_IN_PRODUCTION_LINE",
      "9": "HYDRATE_IN_SERVICE_LINE"
    }
  },
  "preprocess": {
    "resample_freq": "1min",
    "min_points_per_instance": 128,
    "drop_columns_for_features": ["class", "state"],
    "drop_estado_columns": true,
    "min_non_null_ratio_per_channel": 0.5
  },
  "features": {
    "use_raw_channels": true,
    "rolling_windows_minutes": [5, 30],
    "rolling_ops": ["mean", "std"],
    "max_channels_after_reduction": 60
  },
  "splits": {
    "split_unit": "instance",
    "train_ratio": 0.70,
    "val_ratio": 0.15,
    "test_ratio": 0.15,
    "stratify_by": ["event_label", "source_type"],
    "prefer_real_in_test": true,
    "seed": 2027
  },
  "paano": {
    "patch_short": 32,
    "patch_long": 64,
    "embedding_dim": 128,
    "num_iter": 200,
    "batch_size": 256,
    "lr": 0.001,
    "memory_bank_ratio": 0.10,
    "top_k": 5,
    "seed": 2027
  },
  "thresholding": {
    "tune_on": "val",
    "constraint_far_per_day_max": 0.10,
    "constraint_starts_per_event_max": 3.0,
    "constraint_norm_far_max_relative": 1.0,
    "tune_grids": {
      "target_far_per_day": [0.01, 0.05, 0.10, 0.25],
      "min_run_points": [2, 3, 4],
      "ema_alpha": [0.04, 0.08, 0.12],
      "cooldown_hours": [4, 12, 24]
    }
  },
  "evaluation": {
    "main_target": "undesirable_start",
    "lead_tolerance_hours": 24.0,
    "late_tolerance_hours": 24.0
  }
}
